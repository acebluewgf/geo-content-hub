# ---------------------------------------------------------------------------
# GEO Content Hub 环境变量模板
# 复制为 .env.local 后填写；.env.local 已被 .gitignore 忽略，切勿提交。
# 微功夫信息技术南通有限公司 · https://www.weigongfu.com · https://www.wgf.hk
# ---------------------------------------------------------------------------

# 运行环境：development | production
APP_ENV=development

# 监听地址与对外基址（生成回跳链接、图片地址时使用）
APP_ADDR=127.0.0.1:8080
APP_BASE_URL=http://127.0.0.1:8080

# 数据库：二选一。DB_DSN 优先，留空则由下面五个字段拼接。
DB_DSN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=contenthub
DB_USER=contenthub
DB_PASSWORD=change-me

# 上传文件目录
MEDIA_DIR=storage/uploads

# 会话与令牌签名密钥，至少 32 位随机字符串
# 生成：openssl rand -hex 32
SESSION_SECRET=